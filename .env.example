# 한국투자증권 KIS API
KIS_APP_KEY=여기에_앱키
KIS_APP_SECRET=여기에_앱시크릿
KIS_ACCOUNT_NO=XXXXXXXX-XX   # 계좌번호 (하이픈 포함)

# DB (웹 서버)
DATABASE_URL=postgresql://stockadmin:stockpass123@localhost:5432/stockdb

# JWT 서명 키 (운영 시 반드시 변경)
SECRET_KEY=dev-secret-change-in-production

# 텔레그램
# BOT_TOKEN: BotFather(@BotFather)에서 /newbot 으로 발급
# CHAT_ID  : 봇에게 메시지 전송 후 아래 URL에서 확인
#   https://api.telegram.org/bot<TOKEN>/getUpdates  → result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
